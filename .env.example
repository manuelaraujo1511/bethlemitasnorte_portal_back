# Copia este archivo a .env y cambia los valores. .env no se sube al repo.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campus
DB_PASSWORD=cambia-esta-clave
DB_NAME=campus
DB_POOL_SIZE=10
# true fuera de desarrollo: la conexión a la base va con TLS.
DB_SSL=false

# Solo desarrollo: root del MySQL de docker-compose, para npm run db:test.
DB_ROOT_PASSWORD=cambia-esta-otra-clave

# Opcionales (valores por defecto):
# MIGRATIONS_DIR=db/migrations
# SEED_FILES=db/seed_dev.sql,db/seed_dev_academic.sql  (en orden, separados por coma)
# db:test usa el cliente mysql: MYSQL='mysql -uroot -h127.0.0.1' y la clave en MYSQL_PWD.
