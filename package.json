{
  "name": "bethlemitasnorte-portal-back",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API del portal Bethlemitas Norte.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/migrate.ts --seed",
    "db:test": "bash db/tests/run.sh",
    "db:dev-passwords": "tsx --env-file-if-exists=.env scripts/dev-passwords.ts",
    "api:lint": "redocly lint openapi.yaml",
    "check": "npm run typecheck && npm run lint && npm run api:lint && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "kysely": "^0.29.7",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.72.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
